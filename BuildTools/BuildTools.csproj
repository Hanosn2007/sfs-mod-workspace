<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>BuildTools</RootNamespace>
    <AssemblyName>BuildTools</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SFSGameRoot Condition="'$(SFSGameRoot)' == '' and Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/Spaceflight Simulator')">$(HOME)/Library/Application Support/Steam/steamapps/common/Spaceflight Simulator</SFSGameRoot>
    <SFSAppBundle Condition="'$(SFSAppBundle)' == ''">$(SFSGameRoot)/SpaceflightSimulatorGame.app</SFSAppBundle>
    <SFSManagedDir Condition="'$(SFSManagedDir)' == ''">$(SFSAppBundle)/Contents/Resources/Data/Managed</SFSManagedDir>
    <SFSModsDir Condition="'$(SFSModsDir)' == ''">$(SFSAppBundle)/Mods</SFSModsDir>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(SFSManagedDir)/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(SFSManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SFSManagedDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="UITools" HintPath="$(SFSModsDir)/UITools/UITools.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(SFSManagedDir)/UniTask.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(SFSManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(SFSManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SFSManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(SFSManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(SFSManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(SFSManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(SFSManagedDir)/UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateSfsReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SFSGameRoot)' == ''" Text="SFSGameRoot is not set." />
    <Error Condition="!Exists('$(SFSManagedDir)/Assembly-CSharp.dll')" Text="Could not find Assembly-CSharp.dll under $(SFSManagedDir)." />
    <Error Condition="!Exists('$(SFSModsDir)/UITools/UITools.dll')" Text="Build and install UITools first." />
  </Target>
</Project>
